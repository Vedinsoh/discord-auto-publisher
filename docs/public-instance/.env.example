# Auto Publisher — PUBLIC INSTANCE configuration
#
# Self-hosters do NOT need any of this. See `.env.example` at the repo root
# and docs/self-hosting.md.
#
# ---------------------------------------------------------------------------
DEPLOYMENT_MODE = "public"

# --- Per-edition Discord applications --------------------------------------
DISCORD_BOT_TOKEN_FREE = ""
DISCORD_BOT_TOKEN_PREMIUM = ""

# Per-edition proxy base URLs (compose service names; override only for a
# custom topology)
PROXY_URL_FREE = "http://proxy-free:8080"
PROXY_URL_PREMIUM = "http://proxy-premium:8080"

# Outbound source IP per edition, so a Cloudflare invalid-request ban on one
# edition cannot take down the other (ADR 0006). Empty = default route.
EGRESS_LOCAL_ADDRESS_FREE = ""
EGRESS_LOCAL_ADDRESS_PREMIUM = ""

# --- Backend ----------------------------------------------------------------
DATABASE_URL = "postgresql://postgres:postgres@host.docker.internal:54322/postgres"
WEB_APP_ORIGIN = "https://auto-publisher.gg"

# --- Bot --------------------------------------------------------------------
BOT_SHARDS = 1
BOT_SHARDS_PER_CLUSTER = 1
# Guild that the bot-admin commands are registered to. Unset = not registered.
BOT_SUPPORT_GUILD_ID = "958709555683033128"

# --- Dashboard --------------------------------------------------------------
# The OAuth application users log in with, plus the two bot applications they
# are invited to. Self-host collapses all three into one; the public instance
# keeps them distinct.
AUTH_SECRET = ""
DISCORD_CLIENT_ID = ""
DISCORD_CLIENT_SECRET = ""
DISCORD_FREE_BOT_ID = ""
DISCORD_PREMIUM_BOT_ID = ""

# Where the dashboard reaches the backend, server-side only — never from the
# browser.
BACKEND_URL = "http://backend:8080"

# Paddle.js runs in the browser, so these two are inlined at build time and
# must be present when the web image is built.
NEXT_PUBLIC_PADDLE_ENVIRONMENT = "sandbox"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN = ""

# --- Alerts (optional; disabled when unset) ---------------------------------
DISCORD_ALERT_WEBHOOK_URL = ""

# --- Paddle (see billing-paddle-setup.md) -----------------------------------
PADDLE_ENVIRONMENT = "sandbox"          # "sandbox" or "production"
PADDLE_API_KEY = ""                     # pdl_sdbx_apikey_... / pdl_live_apikey_...
PADDLE_WEBHOOK_SECRET = ""              # pdl_ntfset_... from the notification destination
PADDLE_PRICE_MONTHLY = ""               # pri_...
PADDLE_PRICE_YEARLY = ""                # pri_...

# --- Outbound email ---------------------------------------------------------
# The statutory withdrawal acknowledgement (ZZP čl. 81.a st. 6) is the only
# mail the stack sends. Empty credentials disable sending, which surfaces as a
# failed acknowledgement and an alert — never a silent no-op.
SMTP_HOST = "smtp.zoho.eu"
SMTP_PORT = "465"                       # 465 = implicit TLS; 587 negotiates STARTTLS
SMTP_USER = ""
SMTP_PASSWORD = ""
SMTP_FROM = "Auto Publisher <support@auto-publisher.gg>"
