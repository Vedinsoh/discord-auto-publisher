# syntax=docker/dockerfile:1
FROM oven/bun:1.2.22-alpine

# Create app user for security
RUN adduser -S app -u 1001

WORKDIR /app

# Copy workspace configuration and package files
# Manifests only, so edits under packages/*/src reuse the cached install layer —
# `dev:start` rebuilds every run. `--parents` keeps the directory
# structure and needs frontend 1.20+, which the pinned syntax line guarantees.
COPY --chown=app:app package.json bun.lock turbo.json ./
COPY --chown=app:app --parents packages/*/package.json apps/bot/package.json ./

# Install all dependencies (skip optional native deps for faster builds)
# Cache mount persists downloads across builds; BUN_INSTALL_CACHE_DIR is
# per-command to stay build-only and survive a USER change.
RUN --mount=type=cache,target=/bun-cache,sharing=locked \
    BUN_INSTALL_CACHE_DIR=/bun-cache bun install --no-optional

# Copy source code with proper ownership for watch mode
COPY --chown=app:app . .

# Generate database client before building the bot (if needed by the build process)
RUN bun run db:generate

# Switch to non-root user for security and watch compatibility
USER app

# Start in development mode (without built-in watch since Docker Compose handles it)
WORKDIR /app/apps/bot
