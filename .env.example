# Copy this file to .env.local for development or .env.production for production
# One shared env file for the whole stack: the backend is edition-agnostic and
# uses the per-edition pairs; bot/proxy services resolve their own token and
# proxy URL from APP_EDITION (set per service in docker-compose).

# Per-edition Discord app tokens
DISCORD_TOKEN_FREE = "YOUR_FREE_DISCORD_APP_TOKEN"
DISCORD_TOKEN_PREMIUM = "YOUR_PREMIUM_DISCORD_APP_TOKEN"

# Per-edition proxy base URLs (compose service names; override only for custom setups)
PROXY_URL_FREE = "http://proxy-free:8080"
PROXY_URL_PREMIUM = "http://proxy-premium:8080"

# Per-edition outbound source IPs for Discord traffic (production Cloudflare
# ban isolation; leave empty in dev for the default route)
EGRESS_LOCAL_ADDRESS_FREE = ""
EGRESS_LOCAL_ADDRESS_PREMIUM = ""

# Backend
DATABASE_URL = "postgresql://postgres:postgres@host.docker.internal:54322/postgres" # Supabase connection string
WEB_APP_ORIGIN = "http://localhost:3100" # Web dashboard origin (CORS allowlist for the public API)

# Bot
BOT_SHARDS = 1 # Number of shards to spawn
BOT_SHARDS_PER_CLUSTER = 1 # Number of shards per cluster

# Alerts (optional; alerts are disabled when unset)
ALERT_WEBHOOK_URL = ""

# Paddle (backend)
PADDLE_ENVIRONMENT = "sandbox" # Paddle environment: "sandbox" or "production"
PADDLE_API_KEY = "" # Paddle API key (pdl_sdbx_apikey_... or pdl_live_apikey_...)
PADDLE_WEBHOOK_SECRET = "" # Paddle webhook secret (pdl_ntfset_...) from the notification destination
PADDLE_PRICE_MONTHLY = "" # Paddle Price ID for monthly plan (pri_...)
PADDLE_PRICE_YEARLY = "" # Paddle Price ID for yearly plan (pri_...)

# Web App env lives in apps/web/.env.example (Next.js only reads env files from its own directory)
